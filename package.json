{
    "name": "winboat",
    "version": "1.0.7",
    "description": "Windows for Penguins",
    "type": "module",
    "main": "main/main.js",
    "engines": {
        "node": ">=23.6.0",
        "bun": ">=1.3.0"
    },
    "scripts": {
        "dev": "bun scripts/dev-server.ts",
        "prepare:freerdp": "bun scripts/prepare-freerdp.mjs",
        "prepare:electron": "bun scripts/prepare-electron.mjs",
        "build:gs": "bash build-guest-server.sh",
        "build:linux-gs": "bun run prepare:electron && bash build-guest-server.sh && bun scripts/build.ts && electron-builder --linux --x64"
    },
    "repository": "https://github.com/TibixDev/winboat",
    "author": {
        "name": "TibixDev",
        "url": "https://github.com/TibixDev",
        "email": "staff@winboat.app"
    },
    "devDependencies": {
        "@types/node-fetch": "^2.6.13",
        "@types/turndown": "^5.0.6",
        "@vitejs/plugin-vue": "^6.0.4",
        "autoprefixer": "^10.4.24",
        "chalk": "^5.6.2",
        "chokidar": "^5.0.0",
        "electron": "43.2.0",
        "electron-builder": "^26.7.0",
        "postcss": "^8.5.6",
        "prettier": "3.8.1",
        "proper-lockfile": "^4.1.2",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vue-tsc": "^3.2.4"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.0",
        "@vueuse/core": "^14.2.0",
        "check-disk-space": "^3.4.0",
        "consola": "^3.4.2",
        "form-data": "^4.0.5",
        "jimp": "1.6.1",
        "marked": "^17.0.1",
        "nanoevents": "^9.1.0",
        "node-fetch": "2",
        "path-browserify": "^1.0.1",
        "turndown": "^7.2.2",
        "usb": "2.18.0",
        "vue": "^3.5.27",
        "vue-router": "^5.0.2",
        "xel": "^0.40.3",
        "yaml": "^2.8.2"
    },
    "patchedDependencies": {
        "usb@2.18.0": "patches/usb@2.18.0.patch"
    }
}
