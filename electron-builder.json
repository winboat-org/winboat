{
    "appId": "com.teabox.winboat",
    "productName": "WinBoat",
    "directories": {
        "output": "dist"
    },
    "publish": null,
    "electronVersion": "43.2.0",
    "electronDist": ".cache/electron/electron-winboat-v43.2.0-1-linux-x64.zip",
    "electronLanguages": ["en-US"],
    "afterPack": "scripts/after-pack.mjs",
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "shortcutName": "WinBoat"
    },
    "win": {
        "target": "nsis"
    },
    "linux": {
        "icon": "icons/winboat_logo.svg",
        "target": ["appimage", "deb", "rpm", "tar.bz2"],
        "category": "Utility",
        "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "files": [
        "package.json",
        {
            "from": "build/main",
            "to": "main",
            "filter": ["**/*"]
        },
        {
            "from": "build/renderer",
            "to": "renderer",
            "filter": ["**/*"]
        },
        {
            "from": "src/main/static",
            "to": "static",
            "filter": ["**/*"]
        }
    ],
    "extraResources": [
        {
            "from": "./guest_server/dist",
            "to": "guest_server",
            "filter": ["**/*"]
        },
        {
            "from": "./data",
            "to": "data",
            "filter": ["**/*"]
        }
    ]
}
